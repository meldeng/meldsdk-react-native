# Copy to .env and fill in. The .env file is gitignored — never commit real credentials.
# POC only: a real app creates orders on its backend, so the app never holds the API key.

MELD_API_KEY=
MELD_CUSTOMER_ID=
# Host only, no scheme. Use api-qa.meld.io for QA, api-sb.meld.io for sandbox.
MELD_API_HOST=api-sb.meld.io

# Optional corridor overrides. Defaults are a EU corridor (15 EUR -> BTC, FR) so the NATIVE Apple
# Pay lane works — Mercuryo does not process US/GB users. Switch to the US corridor below to
# exercise the Uphold card widget or Coinbase's provider-hosted Apple Pay page instead.
# MELD_SOURCE_CURRENCY=USD
# MELD_DEST_CURRENCY=USDC
# MELD_COUNTRY=US
# MELD_WALLET=0x4838B106FCe9647Bdf1E7877BF73cE8B0BAD5f97
